<UserControl x:Class="InfoKioskApp.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="#1e1e1e">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Верхняя панель -->
            <RowDefinition Height="Auto"/>
            <!-- Подпанель классов -->
            <RowDefinition Height="*"/>
            <!-- Основная область -->
        </Grid.RowDefinitions>

        <!-- Панель выбора расписания -->
        <StackPanel x:Name="ScheduleButtonsPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,5,0,10">
            <!-- Кнопки расписаний добавляются динамически -->
        </StackPanel>

        <!-- Подпанель классов (листов Excel) -->
        <StackPanel x:Name="ClassButtonsPanel"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10"
                    Visibility="Collapsed">
            <!-- Кнопки классов добавляются динамически -->
        </StackPanel>

        <!-- Основная область -->
        <Border Grid.Row="2"
                Background="#252525"
                CornerRadius="8"
                Padding="10"
                BorderThickness="1"
                BorderBrush="#444">
            <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="ContentArea">
                    <!-- Контент подгружается динамически -->
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
