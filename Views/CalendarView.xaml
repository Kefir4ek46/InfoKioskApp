<UserControl x:Class="InfoKioskApp.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1e1e1e">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- === Заголовок с месяцем === -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <Button Content="⟨" Background="#2D2D30" Foreground="White"
                    Width="40" Height="40" Margin="5" FontSize="18"
                    BorderThickness="0" Cursor="Hand" Click="PrevMonth_Click"/>
            <TextBlock x:Name="MonthLabel"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="10,0"/>
            <Button Content="⟩" Background="#2D2D30" Foreground="White"
                    Width="40" Height="40" Margin="5" FontSize="18"
                    BorderThickness="0" Cursor="Hand" Click="NextMonth_Click"/>
        </StackPanel>

        <!-- === Заголовки дней недели === -->
        <UniformGrid Grid.Row="1" Columns="7" Margin="0,10,0,0">
            <TextBlock Text="Пн" Foreground="#BBBBBB" FontWeight="Bold" TextAlignment="Center"/>
            <TextBlock Text="Вт" Foreground="#BBBBBB" FontWeight="Bold" TextAlignment="Center"/>
            <TextBlock Text="Ср" Foreground="#BBBBBB" FontWeight="Bold" TextAlignment="Center"/>
            <TextBlock Text="Чт" Foreground="#BBBBBB" FontWeight="Bold" TextAlignment="Center"/>
            <TextBlock Text="Пт" Foreground="#BBBBBB" FontWeight="Bold" TextAlignment="Center"/>
            <TextBlock Text="Сб" Foreground="#9AD0FF" FontWeight="Bold" TextAlignment="Center"/>
            <TextBlock Text="Вс" Foreground="#FF9999" FontWeight="Bold" TextAlignment="Center"/>
        </UniformGrid>

        <!-- === Сетка дней === -->
        <UniformGrid x:Name="CalendarGrid"
                     Grid.Row="2"
                     Columns="7"
                     Margin="0,10"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"/>

        <!-- === Легенда === -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,5">
            <StackPanel Orientation="Horizontal" Margin="10,0">
                <Border Background="#b42828" Width="18" Height="18" CornerRadius="3" Margin="0,0,5,0"/>
                <TextBlock Text="Праздник" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,0">
                <Border Background="#289628" Width="18" Height="18" CornerRadius="3" Margin="0,0,5,0"/>
                <TextBlock Text="Каникулы" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,0">
                <Border Background="#1e50b4" Width="18" Height="18" CornerRadius="3" Margin="0,0,5,0"/>
                <TextBlock Text="Выходной" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,0">
                <Border Background="#009696" Width="18" Height="18" CornerRadius="3" Margin="0,0,5,0"/>
                <TextBlock Text="Другое" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
