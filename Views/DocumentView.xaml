<UserControl x:Class="InfoKioskApp.Views.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1e1e1e">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Кнопки документов -->
            <RowDefinition Height="*"/>
            <!-- Просмотр -->
        </Grid.RowDefinitions>

        <!-- Панель кнопок документов -->
        <StackPanel x:Name="DocsButtonsPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10"
                    VerticalAlignment="Top"
                    Height="60"
                    />

        <!-- Область просмотра документа -->
        <Border Grid.Row="1" Margin="0,10" Background="#2d2d2d" CornerRadius="8">
            <Grid x:Name="ContentArea"/>
        </Border>
    </Grid>
</UserControl>
