<UserControl x:Class="InfoKioskApp.Views.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock x:Name="MediaTitle"
                   Grid.Row="0"
                   Text="Медиа"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="10,10,10,5"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"/>

        <!-- Основная зона контента -->
        <Border Grid.Row="1"
                Margin="10"
                CornerRadius="10"
                Background="#252525"
                BorderBrush="#444"
                BorderThickness="1">
            <Grid x:Name="ContentArea"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Opacity="1"/>
        </Border>

        <!-- Панель управления -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,15">

            <Button Content="⏮ Предыдущее"
                    Click="Prev_Click"
                    Width="150"
                    Margin="5"
                    Background="#3A3A3A"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Padding="8,5"/>

            <Button x:Name="PlayPauseButton"
                    Content="⏸ Пауза"
                    Click="PlayPause_Click"
                    Width="130"
                    Margin="5"
                    Background="#3A6DF0"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Padding="8,5"/>

            <Button Content="⏭ Следующее"
                    Click="Next_Click"
                    Width="150"
                    Margin="5"
                    Background="#3A3A3A"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Padding="8,5"/>
        </StackPanel>
    </Grid>
</UserControl>
