<UserControl x:Class="InfoKioskApp.Views.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:InfoKioskApp.Models"
             xmlns:conv="clr-namespace:InfoKioskApp.Converters"
             MinWidth="700" MinHeight="480">
    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <DropShadowEffect x:Key="DropShadow"
                  Color="Black"
                  BlurRadius="14"
                  ShadowDepth="3"
                  Opacity="0.35"/>

    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верх: категории -->
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" x:Name="CategoryPanel" VerticalAlignment="Center" />
        </ScrollViewer>

        <!-- Плитки 3×2 -->
        <Grid Grid.Row="1" Margin="0,10,0,10">

            <ItemsControl x:Name="PostsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" Rows="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <!-- Отступы между элементами -->
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="14"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>

                <!-- Шаблон плитки -->
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1A1A1A"
            CornerRadius="14"
            Cursor="Hand"
            SnapsToDevicePixels="True"
            Effect="{DynamicResource DropShadow}">

                            <Grid MouseDown="PostCard_MouseDown">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <!-- Фото занимает всё оставшееся -->
                                    <RowDefinition Height="90"/>
                                    <!-- Текстовый блок фиксированной высоты -->
                                </Grid.RowDefinitions>

                                <!-- === КАРТИНКА === -->
                                <Grid Grid.Row="0" ClipToBounds="True">
                                    <Image Source="{Binding CoverBitmap}"
                       Stretch="UniformToFill"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
                                </Grid>

                                <!-- === НИЖНИЙ ТЕКСТОВЫЙ БЛОК === -->
                                <Border Grid.Row="1" Background="#333"  Padding="14,10,14,12"   >

                                    <StackPanel VerticalAlignment="Bottom" >

                                        <!-- Заголовок -->
                                        <TextBlock Text="{Binding Title}"
                                            FontFamily="Segoe UI Emoji"
                                            Foreground="White"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            TextWrapping="Wrap"
                                            TextTrimming="CharacterEllipsis"
                                             MaxHeight="38"/>
                                        <!-- ровно 2 строки -->

                                        <!-- Дата + Фото -->
                                        <StackPanel Orientation="Horizontal" Margin="16">
                                            <TextBlock Text="{Binding Date}" FontSize="12" Foreground="#b0b0b0"/>
                                            <TextBlock  Text="{Binding ImagesCount, StringFormat='       Фото: {0}'}" FontSize="12" Foreground="#9aa"/>
                                        </StackPanel>

                                    </StackPanel>

                                </Border>

                            </Grid>
                        </Border>
                    </DataTemplate>




                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>






        <!-- Пагинация -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="PrevPageBtn" Content="◀" Click="PrevPageBtn_Click" Margin="4"/>
            <TextBlock x:Name="PageInfo" VerticalAlignment="Center" Margin="8,0" Foreground="White"/>
            <Button x:Name="NextPageBtn" Content="▶" Click="NextPageBtn_Click" Margin="4" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</UserControl>
