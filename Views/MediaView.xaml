<UserControl x:Class="InfoKioskApp.Views.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:InfoKioskApp.Models"
             xmlns:conv="clr-namespace:InfoKioskApp.Converters"
             MinWidth="700" MinHeight="480">
    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <DropShadowEffect x:Key="DropShadow"
                  Color="Black"
                  BlurRadius="14"
                  ShadowDepth="3"
                  Opacity="0.35"/>

    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верх: категории -->
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" x:Name="CategoryPanel" VerticalAlignment="Center" />
        </ScrollViewer>

        <!-- Плитки 3×3 без прокрутки -->
        <Grid Grid.Row="1" Margin="0,10,0,10">

            <ItemsControl x:Name="PostsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" Rows="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="14"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1a1a1a"
            CornerRadius="14"
            Cursor="Hand"
            SnapsToDevicePixels="True"
            Effect="{DynamicResource DropShadow}">

                            <Grid MouseDown="PostCard_MouseDown"
              DataContext="{Binding}">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="220"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Изображение с overlay -->
                                <Grid Grid.Row="0" Background="#111" ClipToBounds="True">

                                    <Image Source="{Binding CoverBitmap}"
                       Stretch="UniformToFill"
                       StretchDirection="Both"/>

                                    <!-- Нижняя тёмная подложка под названием -->
                                    <Border Background="#AA000000"
                        VerticalAlignment="Bottom"
                        Padding="8,6">
                                        <TextBlock Text="{Binding Title}"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>
                                    </Border>

                                </Grid>

                                <!-- Ниже: дата и количество фото -->
                                <StackPanel Grid.Row="1" Margin="14,10,14,14">
                                    <TextBlock Text="{Binding Date}"
                           FontSize="12"
                           Foreground="#b0b0b0"/>

                                    <TextBlock Text="{Binding ImagesCount, StringFormat='Фото: {0}'}"
                           FontSize="12"
                           Foreground="#9aa"
                           Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>

                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>





        <!-- Пагинация -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="PrevPageBtn" Content="◀" Click="PrevPageBtn_Click" Margin="4"/>
            <TextBlock x:Name="PageInfo" VerticalAlignment="Center" Margin="8,0" Foreground="White"/>
            <Button x:Name="NextPageBtn" Content="▶" Click="NextPageBtn_Click" Margin="4"/>
        </StackPanel>
    </Grid>
</UserControl>
