<Window x:Class="InfoKioskApp.Views.PostViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"


        WindowStyle="None"
        AllowsTransparency="True"
        Background="#AA000000"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        ResizeMode="NoResize">

    <Grid>

        <!-- MAIN PANEL -->
        <Border Background="#222"
                CornerRadius="16"
                Padding="24"
                Margin="60">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.9*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDE -->
                <Grid Grid.Column="0" Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <TextBlock x:Name="TitleText"
                         FontFamily="Segoe UI Emoji"
                         FontSize="32"
                         FontWeight="Bold"
                         Foreground="White"
                         TextWrapping="Wrap" />

                    <!-- Дата -->
                    <TextBlock x:Name="DateText"
               Grid.Row="1"
               Foreground="#BBBBBB"
               Margin="0,10,0,0"/>

                    <!-- Описание с прокруткой -->
                    <Border Grid.Row="2"
            Background="#1A1A1A"
            CornerRadius="8"
            Padding="12"
            Margin="0,16,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="DescriptionText"
                       Foreground="#EEEEEE"
                       TextWrapping="Wrap"
                       FontSize="18"
                       FontFamily="Segoe UI Emoji"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Кнопка добавления фото -->
                    <Button Grid.Row="3"
            x:Name="UploadBtn"
            Content="Добавить фото"
            Width="160"
            Height="38"
            Margin="0,20,0,0"
            Click="UploadBtn_Click"
            Visibility="Collapsed"/> 
                </Grid>


                <!-- RIGHT SIDE -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="#111" CornerRadius="8" Padding="12">
                        <Image x:Name="MainImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,16,0,0">

                        <Button x:Name="PrevBtn"
                                Content="⟨"
                                FontSize="32"
                                Width="60"
                                Height="60"
                                Margin="12,0"
                                Click="PrevImage_Click"/>

                        <TextBlock x:Name="ImageCounter"
                                   Foreground="White"
                                   FontSize="20"
                                   VerticalAlignment="Center"
                                   Margin="20,0"/>

                        <Button x:Name="NextBtn"
                                Content="⟩"
                                FontSize="32"
                                Width="60"
                                Height="60"
                                Margin="12,0"
                                Click="NextImage_Click"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>

        <!-- CLOSE BUTTON -->
        <Button x:Name="CloseBtn"
                Content="✕"
                Width="50"
                Height="50"
                FontSize="20"
                Background="#f00000"
                Foreground="White"
                BorderBrush="{x:Null}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="25"
                Click="CloseBtn_Click"/>
    </Grid>
</Window>
