<UserControl x:Class="InfoKioskApp.Views.AdminTabs.ScheduleSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Настройки расписаний"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,15"/>

        <!-- Список расписаний -->
        <ListBox x:Name="ScheduleList"
                 Grid.Row="1"
                 Background="#252525"
                 Foreground="White"
                 BorderThickness="1"
                 BorderBrush="#3A3A3A"
                 SelectionMode="Single"
                 ItemContainerStyle="{StaticResource {x:Type ListBoxItem}}"
                 Margin="0,0,0,15">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#3A3A3A" BorderThickness="0,0,0,1" Padding="6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Width="200" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Type}" Width="100" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FilePath}" Width="300" Foreground="#999999" VerticalAlignment="Center"/>
                            <Button Content="🖊 Изм." Width="90" Background="Green" Margin="6,0" Click="Edit_Click"/>
                            <Button Content="🗑 Удалить" Width="100"  Background="Red" Margin="10,0" Click="Delete_Click"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Панель добавления -->
        <Border Grid.Row="2" Background="#252525" Padding="10" CornerRadius="10" BorderBrush="#3A3A3A" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBox x:Name="NameBox" Width="160" Height="30" Background="Gray" Margin="5" TextChanged="NameBox_TextChanged" />
                <ComboBox x:Name="TypeBox" Width="120" Background="#FF928484"  Height="30" Margin="5" SelectedIndex="0" Foreground="Black">
                    <ComboBoxItem Foreground="Black" Content="excel" Background="gray" />
                    <ComboBoxItem Content="pdf" Background="gray"/>
                    <ComboBoxItem Content="image" Background="gray"/>
                </ComboBox>
                <TextBox x:Name="PathBox" Width="280" Height="30" Margin="5" IsReadOnly="True" Background="#333"/>
                <Button Content="📂" Width="40" Height="30" Background="Gray" Foreground="Black"  Margin="5" Click="Browse_Click"/>
                <Button Content="➕ Добавить" Width="120" Height="30" Background="Green" Margin="5" Click="Add_Click"/>
                <Button Content="💾 Сохранить всё" Width="140" Height="30" Background="#2A82DA" Margin="5" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
