<UserControl x:Class="InfoKioskApp.Views.AdminTabs.ScheduleSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1e1e1e">
    <UserControl.Resources>
        <DataTemplate x:Key="OtherScheduleTemplate">
            <Border Background="#333" Margin="3" Padding="6" CornerRadius="4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding}" Foreground="White" FontSize="14" Width="400"/>
                    <Button Content="🗑" Width="30" Height="30"
                        Background="#b33" Foreground="White"
                        CommandParameter="{Binding}" 
                        Click="DeleteOther_Click"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <TextBlock Text="Настройки расписаний" 
                       FontSize="20" 
                       Foreground="White"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <!-- === Основное расписание === -->
            <Border Background="#252525" Padding="15" CornerRadius="8" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="📘 Основное расписание" 
                               FontSize="16" Foreground="White" FontWeight="Bold"/>
                    <TextBlock Text="Выберите файл Excel для основного расписания." 
                               Foreground="#ccc" Margin="0,4,0,10"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="MainScheduleBox" Width="400" Margin="0,0,10,0"/>
                        <Button Content="📂 Обзор" Background="#fa0" Width="100" Click="BrowseMain_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- === Изменённое расписание === -->
            <Border Background="#252525" Padding="15" CornerRadius="8" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="📝 Изменённое расписание" 
                               FontSize="16" Foreground="White" FontWeight="Bold"/>
                    <TextBlock Text="Форматы: Excel, PDF, DOCX, изображения" 
                               Foreground="#ccc" Margin="0,4,0,10"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="ChangesBox" Width="400" Margin="0,0,10,0"/>
                        <Button Content="📂 Обзор" Width="100" Background="#fa0" Click="BrowseChanges_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- === Другие расписания === -->
            <Border Background="#252525" Padding="15" CornerRadius="8" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="📚 Другие расписания" 
                               FontSize="16" Foreground="White" FontWeight="Bold"/>
                    <TextBlock Text="Добавьте дополнительные расписания (любой формат)" 
                               Foreground="#ccc" Margin="0,4,0,10"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="OtherNameBox" Width="200" Margin="0,0,10,0" Background="Gray" Text="Название"/>
                        <TextBox x:Name="OtherPathBox" Width="300" Background="Gray" Margin="0,0,10,0"/>
                        <Button Content="📂 Обзор" Width="90" Background="#fa0" Click="BrowseOther_Click"/>
                        <Button Content="➕ Добавить" Background="Green" Width="100" Click="AddOther_Click"/>
                    </StackPanel>

                    <ListBox x:Name="OtherSchedulesList" Height="180" Background="#2b2b2b"
                             Foreground="White" BorderThickness="0" Margin="0,5,0,0"
                             ItemTemplate="{StaticResource OtherScheduleTemplate}"/>
                </StackPanel>
            </Border>

            <Button Content="💾 Сохранить настройки" 
                    Background="#3A6DF0" 
                    Foreground="White" 
                    Padding="10" FontWeight="Bold"
                    Click="Save_Click"
                    HorizontalAlignment="Center"
                    Width="220"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
