<UserControl x:Class="InfoKioskApp.Views.AdminTabs.AboutDeveloperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1e1e1e">

    <Border Background="#2b2b2b"
            CornerRadius="12"
            Padding="20"
            Margin="15"
            BorderBrush="#3a3a3a"
            BorderThickness="1">

        <StackPanel>
            <TextBlock Text="О разработчике"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,15"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Background="#1e1e1e"
                          BorderBrush="#444"
                          BorderThickness="1"
                          Padding="10"
                          >
                <TextBlock x:Name="AboutText"
                           TextWrapping="Wrap"
                           Foreground="White"
                           FontSize="16"
                           FontFamily="Segoe UI"
                           Margin="5"/>
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>
