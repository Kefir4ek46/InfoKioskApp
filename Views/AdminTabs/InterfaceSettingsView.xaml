<UserControl x:Class="InfoKioskApp.Views.AdminTabs.InterfaceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#2D2D30">
    <StackPanel Margin="20" Orientation="Vertical">
        <TextBlock Text="Настройки интерфейса" 
                   Foreground="White" FontSize="20" FontWeight="Bold" Margin="0 0 0 20"/>

        <!-- Тема -->
        <StackPanel Orientation="Horizontal" Margin="0 10">
            <TextBlock Text="Тема:" Foreground="White" Width="150" VerticalAlignment="Center"/>
            <ComboBox x:Name="ThemeSelector" Width="200" SelectionChanged="ThemeSelector_SelectionChanged">
                <ComboBoxItem Content="Тёмная" Tag="dark"/>
                <ComboBoxItem Content="Светлая" Tag="light"/>
            </ComboBox>
        </StackPanel>

        <!-- Шрифт -->
        <StackPanel Orientation="Horizontal" Margin="0 10">
            <TextBlock Text="Шрифт:" Foreground="White" Width="150" VerticalAlignment="Center"/>
            <ComboBox x:Name="FontSelector" Width="200" SelectionChanged="FontSelector_SelectionChanged">
                <ComboBoxItem Content="Segoe UI"/>
                <ComboBoxItem Content="Arial"/>
                <ComboBoxItem Content="Calibri"/>
                <ComboBoxItem Content="Verdana"/>
            </ComboBox>
        </StackPanel>

        <!-- Размер шрифта -->
        <StackPanel Orientation="Horizontal" Margin="0 10">
            <TextBlock Text="Размер шрифта:" Foreground="White" Width="150" VerticalAlignment="Center"/>
            <Slider x:Name="FontSizeSlider" Minimum="10" Maximum="24" Width="200" ValueChanged="FontSizeSlider_ValueChanged"/>
            <TextBlock x:Name="FontSizeValue" Text="14" Foreground="White" Margin="10,0,0,0"/>
        </StackPanel>

        <Button Content="💾 Сохранить" Width="200" Height="40" Margin="0 30 0 0"
                Background="#007ACC" Foreground="White" Click="Save_Click"/>
    </StackPanel>
</UserControl>
