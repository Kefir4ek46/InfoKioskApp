<UserControl x:Class="InfoKioskApp.Views.AdminTabs.InterfaceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             Background="#2D2D30">

    <StackPanel Margin="20" Orientation="Vertical">
        <TextBlock Text="Настройки интерфейса" 
                   Foreground="White" FontSize="20" FontWeight="Bold" Margin="0 0 0 20"/>

        <!-- Тема -->
        <StackPanel Orientation="Horizontal" Margin="0 10">
            <TextBlock Text="Тема:" Foreground="White" Width="150" VerticalAlignment="Center"/>
            <ComboBox x:Name="ThemeSelector" Width="200" SelectionChanged="ThemeSelector_SelectionChanged">
                <ComboBoxItem Content="Тёмная" Tag="dark"/>
                <ComboBoxItem Content="Светлая" Tag="light"/>
            </ComboBox>
        </StackPanel>

        <!-- Цвет фона -->
        <StackPanel Orientation="Horizontal" Margin="0 10">
            <TextBlock Text="Цвет фона:" Foreground="White" Width="150" VerticalAlignment="Center"/>
            <xctk:ColorPicker x:Name="BackgroundColorPicker"
                              Width="200"
                              SelectedColorChanged="ColorPicker_SelectedColorChanged"/>
        </StackPanel>

        <!-- Цвет кнопок -->
        <StackPanel Orientation="Horizontal" Margin="0 10">
            <TextBlock Text="Цвет кнопок:" Foreground="White" Width="150" VerticalAlignment="Center"/>
            <xctk:ColorPicker x:Name="ButtonColorPicker"
                              Width="200"
                              SelectedColorChanged="ColorPicker_SelectedColorChanged"/>
        </StackPanel>

        <!-- Цвет текста -->
        <StackPanel Orientation="Horizontal" Margin="0 10">
            <TextBlock Text="Цвет текста:" Foreground="White" Width="150" VerticalAlignment="Center"/>
            <xctk:ColorPicker x:Name="TextColorPicker"
                              Width="200"
                              SelectedColorChanged="ColorPicker_SelectedColorChanged"/>
        </StackPanel>

        <!-- Кнопки управления -->
        <StackPanel Orientation="Horizontal" Margin="0 20 0 0">
            <Button Content="✅ Применить" Width="150" Height="40" Margin="0,0,10,0"
                    Background="Green" Foreground="White" Click="Apply_Click"/>
            <Button Content="💾 Сохранить" Width="150" Height="40"
                    Background="#2A82DA" Foreground="White" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
