<UserControl x:Class="InfoKioskApp.Views.AdminTabs.CustomSectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="20">
        <TextBlock Text="Пользовательские разделы" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0 0 0 20"/>

        <ListBox x:Name="SectionsList" Height="200" DisplayMemberPath="Name" />

        <StackPanel Orientation="Horizontal" Margin="0 10">
            <Button Content="➕ Добавить" Width="120" Margin="5" Click="Add_Click" Background="Green"/>
            <Button Content="❌ Удалить" Width="120" Margin="5" Click="Remove_Click" Background="Red"/>
            <Button Content="💾 Сохранить" Width="120" Margin="5" Click="Save_Click" Background="Blue"/>
        </StackPanel>
    </StackPanel>
</UserControl>
