<UserControl x:Class="InfoKioskApp.Views.AdminTabs.WeatherSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1e1e1e">

    <Border Background="#2b2b2b" CornerRadius="10" Padding="15" Margin="15">
        <StackPanel>
            <TextBlock Text="Настройки погоды" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Foreground="White"
                       Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Город:" Foreground="White" Width="120" VerticalAlignment="Center"/>
                <TextBox x:Name="CityBox" Width="200" Background="#333" Foreground="White"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10">
                <TextBlock Text="Широта:" Foreground="White" Width="120" VerticalAlignment="Center"/>
                <TextBox x:Name="LatitudeBox" Width="120" Background="#333" Foreground="White" Margin="5,0"/>
                <TextBlock Text="Долгота:" Foreground="White" Width="120" VerticalAlignment="Center"/>
                <TextBox x:Name="LongitudeBox" Width="120" Background="#333" Foreground="White" Margin="5,0"/>
            </StackPanel>

            <Button Content="💾 Сохранить настройки" 
                    Width="220" Height="40" 
                    Margin="0,20,0,0"
                    Background="#3a6df0" 
                    Foreground="White"
                    FontWeight="Bold"
                    Click="Save_Click"/>
        </StackPanel>
    </Border>
</UserControl>
