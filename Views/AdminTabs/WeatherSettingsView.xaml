<UserControl x:Class="InfoKioskApp.Views.AdminTabs.WeatherSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#1E1E1E"
             d:DesignHeight="400" d:DesignWidth="600">

    <StackPanel Margin="30" VerticalAlignment="Top">
        <TextBlock Text="Настройки погоды (Open-Meteo)" 
                   FontSize="22" Foreground="White"
                   Margin="0,0,0,20"/>

        <TextBlock Text="Город (на английском или русском):" 
                   Foreground="#CCCCCC"/>
        <TextBox x:Name="CityBox" 
                 Margin="0,5,0,20" 
                 Height="30"
                 Background="#2D2D2D" Foreground="White"
                 BorderThickness="0" Padding="5"/>

        <Button Content="💾 Сохранить" 
                Width="150" Height="40"
                HorizontalAlignment="Left"
                Background="#007ACC" 
                Foreground="White"
                BorderThickness="0"
                Click="Save_Click"/>
    </StackPanel>
</UserControl>
