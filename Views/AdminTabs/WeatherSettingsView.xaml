<UserControl x:Class="InfoKioskApp.Views.AdminTabs.WeatherSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#222">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Настройки погоды"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,10"/>

        <!-- Настройки -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="12">

            <CheckBox x:Name="ShowWeatherCheckbox"
                      Content="Отображать погоду на главном экране"
                      Foreground="White"
                      FontSize="14"/>

            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBlock Text="API ключ:" Width="120" Foreground="White" VerticalAlignment="Center"/>
                <TextBox x:Name="ApiKeyInput"
                         Width="400"
                         Height="28"
                         Background="#333"
                         Foreground="White"
                         BorderBrush="#555"
                         BorderThickness="1"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBlock Text="ID города:" Width="120" Foreground="White" VerticalAlignment="Center"/>
                <TextBox x:Name="CityIdInput"
                         Width="400"
                         Height="28"
                         Background="#333"
                         Foreground="White"
                         BorderBrush="#555"
                         BorderThickness="1"/>
            </StackPanel>

            <Button Content="Проверить подключение"
                    Click="TestWeather_Click"
                    Width="200"
                    Height="30"
                    Background="#2a82da"
                    Foreground="White"
                    Margin="0,20,0,0"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"  Margin="0,10,0,0">
            <Button Content="Сохранить" Click="SaveWeather_Click" Width="120" Height="30" Background="#2a82da" Foreground="White"/>
        </StackPanel>
    </Grid>
</UserControl>
