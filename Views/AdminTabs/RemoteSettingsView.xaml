<UserControl x:Class="InfoKioskApp.Views.AdminTabs.RemoteSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:qrcoder="clr-namespace:QRCoder;assembly=QRCoder"
             xmlns:local="clr-namespace:InfoKioskApp.Views.AdminTabs"
             Background="#1e1e1e">

    <Border Background="#2b2b2b"
            CornerRadius="10"
            Padding="20"
            Margin="15"
            BorderBrush="#3a3a3a"
            BorderThickness="1">
        <StackPanel>
            <TextBlock Text="🌐 Удалённое управление"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Позволяет управлять приложением с другого устройства через локальную сеть."
                       Foreground="#CCCCCC"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                <Button x:Name="StartServerButton"
                        Content="▶ Запустить сервер"
                        Width="180" Height="40"
                        Background="#3A6DF0"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="StartServer_Click"
                        Margin="0,0,10,0"/>

                <Button x:Name="StopServerButton"
                        Content="⏹ Остановить сервер"
                        Width="180" Height="40"
                        Background="#555"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="StopServer_Click"/>
            </StackPanel>

            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="Текущий IP:"
                           FontSize="14"
                           Foreground="#AAAAAA"/>
                <TextBlock x:Name="IpText"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,4,0,0"/>

                <TextBlock Text="Статус сервера:"
                           FontSize="14"
                           Foreground="#AAAAAA"
                           Margin="0,12,0,0"/>
                <TextBlock x:Name="ServerStatus"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#FF6F6F"/>
            </StackPanel>

            <StackPanel x:Name="QrPanel" Visibility="Collapsed" Margin="0,30,0,0" HorizontalAlignment="Center">
                <TextBlock Text="Подключитесь, отсканировав QR-код:"
                           Foreground="White"
                           FontSize="14"
                           TextAlignment="Center"
                           Margin="0,0,0,10"/>
                <Image x:Name="QrImage" Width="200" Height="200" Stretch="Uniform"/>
                <TextBlock x:Name="ConnectUrl"
                           Foreground="#A0D8FF"
                           FontSize="14"
                           Margin="0,10,0,0"
                           TextAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
