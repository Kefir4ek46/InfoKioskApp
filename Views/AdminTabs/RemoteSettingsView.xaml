<UserControl x:Class="InfoKioskApp.Views.AdminTabs.RemoteSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">

    <Border Margin="15" Padding="20" CornerRadius="12" Background="#2B2B2B" BorderBrush="#3A3A3A" BorderThickness="1">
        <StackPanel>

            <TextBlock Text="🌐 Удалённое управление" 
                       FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>

            <!-- IP и порт -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="IP:" Width="60" Foreground="#DDD" VerticalAlignment="Center"/>
                <TextBlock x:Name="IpText" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Порт:" Width="60" Foreground="#DDD" VerticalAlignment="Center"/>
                <TextBox x:Name="PortBox" Width="100" Background="#333" Foreground="White" BorderBrush="#555" Padding="5" />
            </StackPanel>

            <!-- Автозапуск -->
            <CheckBox x:Name="AutoStartCheck"
                      Content="Запускать сервер автоматически при старте приложения"
                      Foreground="White" Margin="0,0,0,10"/>

            <!-- Статус -->
            <TextBlock x:Name="ServerStatus"
                       Text="Сервер не запущен"
                       Foreground="OrangeRed"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <!-- Кнопки управления -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                <Button Content="▶ Запустить" Width="120" Height="40" Margin="5"
                        Background="#3A6DF0" Foreground="White" Click="StartServer_Click"/>
                <Button Content="⏹ Остановить" Width="120" Height="40" Margin="5"
                        Background="#555" Foreground="White" Click="StopServer_Click"/>
                <Button Content="💾 Сохранить настройки" Width="180" Height="40" Margin="5"
                        Background="#4CAF50" Foreground="White" Click="SaveSettings_Click"/>
            </StackPanel>

            <!-- QR-код -->
            <StackPanel x:Name="QrPanel" Visibility="Collapsed" Margin="0,10,0,0" HorizontalAlignment="Center">
                <TextBlock Text="Подключение по локальной сети:" Foreground="#DDD" Margin="0,0,0,5"/>
                <TextBlock x:Name="ConnectUrl" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>
                <Image x:Name="QrImage" Width="200" Height="200"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
