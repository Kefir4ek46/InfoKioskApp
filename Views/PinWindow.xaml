<Window x:Class="InfoKioskApp.Views.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Администратор" 
        Height="220" Width="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Background="#FF1E1E1E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Введите PIN-код:" 
                   Foreground="White"
                   FontSize="18"
                   Margin="0,0,0,15"
                   HorizontalAlignment="Center"/>

        <PasswordBox x:Name="PinInput"
                     Grid.Row="1"
                     FontSize="22"
                     HorizontalAlignment="Center"
                     Width="150"
                     Padding="5"
                     MaxLength="8"
                     HorizontalContentAlignment="Center"
                     Margin="0,0,0,20"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Войти" Width="100" Height="35" Click="Login_Click"/>
            <Button Content="Отмена" Width="100" Height="35" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
