<Window x:Class="InfoKioskApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="InfoKioskApp"
        WindowStyle="None"
        WindowState="Maximized"
        Background="#1E1E1E">
    <Window.Resources>
        <DropShadowEffect x:Key="DropShadowEffect"
                          Color="#000000"
                          BlurRadius="10"
                          ShadowDepth="3"
                          Opacity="0.4"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <!-- Верхняя панель -->
            <RowDefinition Height="*"/>
            <!-- Основная часть -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <!-- Боковое меню -->
            <ColumnDefinition Width="*"/>
            <!-- Контент -->
        </Grid.ColumnDefinitions>

        <!-- ===== Верхняя панель ===== -->
        <Border Grid.ColumnSpan="2" Background="#2C2C2C" Padding="20,10" CornerRadius="0,0,12,12" Effect="{DynamicResource DropShadowEffect}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <!-- Время и дата -->
                    <ColumnDefinition Width="*"/>
                    <!-- Статус урока -->
                    <ColumnDefinition Width="auto"/>
                    <!-- Погода -->
                </Grid.ColumnDefinitions>

                <!-- Время и дата -->
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock x:Name="TimeText" FontSize="36" Foreground="White" TextAlignment="Left"/>
                    <TextBlock x:Name="DateText" FontSize="16" Foreground="#BBBBBB"/>
                </StackPanel>

                <!-- Статус урока -->
                <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="LessonStatusText" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="#F5F5F5" 
                               TextAlignment="Center"/>
                    <TextBlock x:Name="LessonTimeInfo" 
                               FontSize="16" 
                               Foreground="#AAAAAA" 
                               TextAlignment="Center"/>
                </StackPanel>

                <!-- Погода -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="WeatherIcon" FontSize="28" Margin="0,0,5,0"/>
                    <TextBlock x:Name="WeatherTemp" FontSize="20" Foreground="White" Margin="0,0,5,0"/>
                    <TextBlock x:Name="WeatherCity" FontSize="16" Foreground="#BBBBBB"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Боковое меню ===== -->
        <DockPanel Grid.Row="1" Background="#252525" Margin="10" LastChildFill="False">
            <!-- Основные кнопки -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button Content="📅 Расписание" Click="Schedule_Click" Style="{StaticResource MenuButtonStyle}" Margin="0,5,0,0"/>
                <Button Content="🖼️ Медиа" Click="Media_Click" Style="{StaticResource MenuButtonStyle}" Margin="0,5,0,0"/>
                <Button Content="📄 Документы" Click="Documents_Click" Style="{StaticResource MenuButtonStyle}" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Разделитель -->
            <Separator DockPanel.Dock="Bottom" Margin="0,10,0,10" Background="#444" Height="2"/>

            <!-- Кнопка администратора -->
            <StackPanel DockPanel.Dock="Bottom">
                <Button Content="⚙️ Админ" Click="Admin_Click" Style="{StaticResource MenuButtonStyle}" Margin="0,5,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ===== Контентная область ===== -->
        <Border Grid.Row="1" Grid.Column="1" Margin="15" Background="#1A1A1A" CornerRadius="12">
            <ContentControl x:Name="ContentArea" Margin="10"/>
        </Border>
    </Grid>
</Window>

