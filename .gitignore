#######################################
# 🔥 SPECIFIC TO YOUR PROJECT
#######################################

# Web admin panel cache
RemoteAccess/wwwroot/cache/

# Media uploaded files
data/media/
data/posts/
data/uploads/

# Settings cache
data/config.json
data/settings.json

# Local server temp folders
server/cache/
server/logs/

# 🔥 DO NOT PUSH installers:
Installer/*.exe
Installer/*.msi
Installer/*.bat

# ignore WebView2 installer
WebView2Setup.exe
dotnet-runtime-*.exe
dotnet-desktop-*.exe

# ignore publish output (WPF)
publish/
app.publish/
InfoKioskApp/net9.0-windows/
InfoKioskApp/bin/
InfoKioskApp/obj/

# ignore screenshots / assets
*.png
*.jpg
*.jpeg
*.bmp
!.svn
