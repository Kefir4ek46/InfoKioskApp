<UserControl x:Class="InfoKioskApp.Views.SchoolWebsiteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="#1E1E1E"
             KeyDown="OnKeyDown">
    <Grid>
        <!-- Полноэкранный WebView2 с сайтом школы -->
        <wv2:WebView2 x:Name="WebView"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"/>

        <!-- Кнопка "Назад в киоск" сверху-слева, поверх сайта.
             Всегда видна — чтобы пользователь всегда мог вернуться в киоск. -->
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="16"
                Background="#CC1E1E1E"
                BorderBrush="#3A3A3A"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0">
            <Button x:Name="BackButton"
                    Content="← Назад в киоск"
                    Background="Transparent"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="14"
                    Padding="14,10"
                    Cursor="Hand"
                    Click="BackButton_Click"/>
        </Border>

        <!-- Индикатор загрузки / ошибка (показывается до первой успешной
             навигации или при ошибке). Содержимое управляется из C#. -->
        <Border x:Name="LoadingOverlay"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="#1E1E1E">
            <StackPanel x:Name="LoadingPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="600"
                        Margin="32">
                <TextBlock x:Name="LoadingIcon"
                           Text="⏳"
                           FontSize="48"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,14"/>
                <TextBlock x:Name="LoadingText"
                           Text="Открываем сайт школы…"
                           Foreground="#9CA3AF"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="LoadingSubtext"
                           Text="Это может занять несколько секунд"
                           Foreground="#6B7280"
                           FontSize="13"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
