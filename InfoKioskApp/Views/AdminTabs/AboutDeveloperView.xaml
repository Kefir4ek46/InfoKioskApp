<UserControl x:Class="InfoKioskApp.Views.AdminTabs.AboutDeveloperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#20222A">

    <Border Background="#262933"
            CornerRadius="12"
            Padding="20"
            Margin="16"
            BorderBrush="#343848"
            BorderThickness="1">

        <StackPanel>
            <TextBlock Text="О разработчике"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,16"/>

            <Border Background="#1F2129" BorderBrush="#343848" BorderThickness="1" CornerRadius="8" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="AboutText"
                               TextWrapping="Wrap"
                               Foreground="#E6EAF2"
                               FontSize="16"
                               FontFamily="Segoe UI"
                               Margin="6"/>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
