<UserControl x:Class="InfoKioskApp.Views.AdminTabs.ScheduleSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#20222A">

    <UserControl.Resources>
        <DataTemplate x:Key="OtherScheduleTemplate">
            <Border Background="#1F2129" Margin="4" Padding="8" CornerRadius="6" BorderBrush="#343848" BorderThickness="1">
                <DockPanel>
                    <Button Content="Удалить"
                            Width="90"
                            Height="28"
                            Background="#C44747"
                            Foreground="White"
                            BorderThickness="0"
                            DockPanel.Dock="Right"
                            CommandParameter="{Binding}"
                            Click="DeleteOther_Click"/>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="White"/>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="#262933" CornerRadius="12" Padding="20" Margin="16" BorderBrush="#343848" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Настройки расписаний" FontSize="22" Foreground="White" FontWeight="Bold" Margin="0,0,0,18"/>

                <Border Background="#1F2129" Padding="14" CornerRadius="8" Margin="0,0,0,12" BorderBrush="#343848" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📘 Основное расписание" FontSize="16" Foreground="White" FontWeight="SemiBold"/>
                        <TextBlock Text="Выберите файл Excel для основного расписания." Foreground="#C8D0E0" Margin="0,4,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="MainScheduleBox" Width="440" Height="34" Padding="8,6" Background="#151922" Foreground="White" BorderBrush="#343848" BorderThickness="1" Margin="0,0,10,0"/>
                            <Button Content="📂 Обзор" Background="#3A6DF0" Width="110" Height="34" Foreground="White" BorderThickness="0" Click="BrowseMain_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#1F2129" Padding="14" CornerRadius="8" Margin="0,0,0,12" BorderBrush="#343848" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📝 Изменённое расписание" FontSize="16" Foreground="White" FontWeight="SemiBold"/>
                        <TextBlock Text="Форматы: Excel, PDF, DOCX, изображения" Foreground="#C8D0E0" Margin="0,4,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="ChangesBox" Width="440" Height="34" Padding="8,6" Background="#151922" Foreground="White" BorderBrush="#343848" BorderThickness="1" Margin="0,0,10,0"/>
                            <Button Content="📂 Обзор" Width="110" Height="34" Background="#3A6DF0" Foreground="White" BorderThickness="0" Click="BrowseChanges_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#1F2129" Padding="14" CornerRadius="8" Margin="0,0,0,18" BorderBrush="#343848" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📚 Другие расписания" FontSize="16" Foreground="White" FontWeight="SemiBold"/>
                        <TextBlock Text="Добавьте дополнительные расписания (любой формат)" Foreground="#C8D0E0" Margin="0,4,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox x:Name="OtherNameBox" Width="220" Height="34" Margin="0,0,10,0" Background="#151922" Foreground="White" BorderBrush="#343848" BorderThickness="1" Padding="8,6" Text="Название"/>
                            <TextBox x:Name="OtherPathBox" Width="280" Height="34" Margin="0,0,10,0" Background="#151922" Foreground="White" BorderBrush="#343848" BorderThickness="1" Padding="8,6"/>
                            <Button Content="📂 Обзор" Width="90" Height="34" Margin="0,0,10,0" Background="#3A6DF0" Foreground="White" BorderThickness="0" Click="BrowseOther_Click"/>
                            <Button Content="➕ Добавить" Width="100" Height="34" Background="#2D9A56" Foreground="White" BorderThickness="0" Click="AddOther_Click"/>
                        </StackPanel>

                        <ListBox x:Name="OtherSchedulesList" Height="190" Background="#151922" Foreground="White" BorderThickness="0" ItemTemplate="{StaticResource OtherScheduleTemplate}"/>
                    </StackPanel>
                </Border>

                <Button Content="💾 Сохранить настройки" Background="#3A6DF0" Foreground="White" Height="36" Padding="14,6" FontWeight="SemiBold" BorderThickness="0" HorizontalAlignment="Left" Width="220" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
