<UserControl x:Class="InfoKioskApp.Views.AdminTabs.WeatherSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#20222A">

    <Border Background="#262933" CornerRadius="12" Padding="20" Margin="16" BorderBrush="#343848" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Настройки погоды" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Город:" Foreground="#DDE3F1" Width="140" VerticalAlignment="Center"/>
                <TextBox x:Name="CityBox" Width="240" Height="34" Padding="8,6" Background="#1F2129" Foreground="White" BorderBrush="#343848" BorderThickness="1" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Широта:" Foreground="#DDE3F1" Width="140" VerticalAlignment="Center"/>
                <TextBox x:Name="LatitudeBox" Width="140" Height="34" Padding="8,6" Background="#1F2129" Foreground="White" BorderBrush="#343848" BorderThickness="1" VerticalContentAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="Долгота:" Foreground="#DDE3F1" Width="90" VerticalAlignment="Center"/>
                <TextBox x:Name="LongitudeBox" Width="140" Height="34" Padding="8,6" Background="#1F2129" Foreground="White" BorderBrush="#343848" BorderThickness="1" VerticalContentAlignment="Center"/>
            </StackPanel>

            <Button Content="💾 Сохранить настройки"
                    Width="220" Height="36"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Background="#3A6DF0"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Click="Save_Click"/>
        </StackPanel>
    </Border>
</UserControl>
