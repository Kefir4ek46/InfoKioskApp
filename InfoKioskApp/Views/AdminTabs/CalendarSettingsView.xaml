<UserControl x:Class="InfoKioskApp.Views.AdminTabs.CalendarSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="#1e1e1e">

    <Border Background="#2b2b2b"
            CornerRadius="12"
            Padding="20"
            Margin="15"
            BorderBrush="#3a3a3a"
            BorderThickness="1">
        <StackPanel>

            <!-- Заголовок -->
            <TextBlock Text="Настройка событий календаря"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,20"/>

            <!-- === Добавление события === -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,15"
                        VerticalAlignment="Center">

                <!-- Название -->
                <TextBox x:Name="TitleBox"
                         Width="200"
                         Margin="5"
                         Padding="6"
                         FontSize="14"
                         Background="#3a3a3a"
                         Foreground="White"
                         BorderBrush="#555"
                         BorderThickness="1"
                         ToolTip="Введите название события"/>

                <!-- Начало -->
                <DatePicker x:Name="StartDatePicker"
                            Width="150"
                            Margin="5"
                            Padding="4"
                            FontSize="14"
                            
                            Background="#3a3a3a"
                            Foreground="Black"
                            BorderBrush="#555"
                            BorderThickness="1"
                            SelectedDate="{x:Static sys:DateTime.Now}"/>

                <!-- Конец -->
                <DatePicker x:Name="EndDatePicker"
                            Width="150"
                            Margin="5"
                            Padding="4"
                            FontSize="14"
                            Background="#3a3a3a"
                            Foreground="Black"
                            BorderBrush="#555"
                            BorderThickness="1"/>

                <!-- Тип -->
                <ComboBox x:Name="TypeBox"
                          Width="160"
                          Margin="5"
                          Padding="4"
                          FontSize="14"
                          Background="#3a3a3a"
                          Foreground="Black"
                          BorderBrush="#555"
                          BorderThickness="1">
                    <ComboBoxItem Content="Праздник" Foreground="Black" Background="Gray" Tag="Праздник"/>
                    <ComboBoxItem Content="Каникулы" Foreground="Black" Background="Gray" Tag="Каникулы"/>
                    <ComboBoxItem Content="Выходной" Foreground="Black" Background="Gray" Tag="Выходной"/>
                    <ComboBoxItem Content="Другое" Foreground="Black" Background="Gray" Tag="Другое"/>
                </ComboBox>

                <!-- Добавить -->
                <Button Content="➕ Добавить"
                        Width="120"
                        Margin="5"
                        Height="38"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="#3a6df0"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="AddEvent_Click"/>
            </StackPanel>

            <!-- === Список событий === -->
            <Border CornerRadius="8"
                    BorderBrush="#444"
                    BorderThickness="1"
                    Background="#252525"
                    Margin="0,0,0,10"
                    Padding="4">
                <ListView x:Name="EventsList"
                          Height="280"
                          Background="#252525"
                          Foreground="White"
                          BorderThickness="0"
                          SelectionMode="Single">
                    <ListView.Resources>
                        <!-- Цвет выбранного элемента -->
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3A6DF0"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                    </ListView.Resources>

                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Title}" Width="200"/>
                            <GridViewColumn Header="Начало" DisplayMemberBinding="{Binding StartDate}" Width="120"/>
                            <GridViewColumn Header="Окончание" DisplayMemberBinding="{Binding EndDate}" Width="120"/>
                            <GridViewColumn Header="Тип" DisplayMemberBinding="{Binding Type}" Width="120"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- Заголовок таблицы -->
            <Grid Margin="0,-570,0,0" IsHitTestVisible="False">
                <Grid Background="#3a3a3a" Height="30"  >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Название" Foreground="White" FontWeight="Bold" Margin="10,5,0,0"/>
                    <TextBlock Text="Начало" Foreground="White" FontWeight="Bold" Margin="10,5,0,0" Grid.Column="1"/>
                    <TextBlock Text="Окончание" Foreground="White" FontWeight="Bold" Margin="10,5,0,0" Grid.Column="2"/>
                    <TextBlock Text="Тип" Foreground="White" FontWeight="Bold" Margin="10,5,0,0" Grid.Column="3"/>
                </Grid>
            </Grid>

            <!-- === Кнопки управления === -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="🗑 Удалить выбранное"
                        Width="170"
                        Margin="5"
                        Height="40"
                        Background="#d9534f"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="RemoveEvent_Click"/>
                <Button Content="💾 Сохранить"
                        Width="140"
                        Margin="5"
                        Height="40"
                        Background="#28a745"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="SaveEvents_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
