<UserControl x:Class="InfoKioskApp.Views.AdminTabs.CalendarSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="#20222A">

    <Border Background="#262933" CornerRadius="12" Padding="20" Margin="16" BorderBrush="#343848" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Настройка событий календаря" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

            <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBox x:Name="TitleBox" Width="220" Height="34" Margin="0,0,8,8" Padding="8,6" FontSize="14" Background="#1F2129" Foreground="White" BorderBrush="#343848" BorderThickness="1" ToolTip="Введите название события"/>
                <DatePicker x:Name="StartDatePicker" Width="160" Height="34" Margin="0,0,8,8" SelectedDate="{x:Static sys:DateTime.Now}"/>
                <DatePicker x:Name="EndDatePicker" Width="160" Height="34" Margin="0,0,8,8"/>
                <ComboBox x:Name="TypeBox" Width="170" Height="34" Margin="0,0,8,8" Background="#1F2129" Foreground="White" BorderBrush="#343848" BorderThickness="1">
                    <ComboBoxItem Content="Праздник" Tag="Праздник"/>
                    <ComboBoxItem Content="Каникулы" Tag="Каникулы"/>
                    <ComboBoxItem Content="Выходной" Tag="Выходной"/>
                    <ComboBoxItem Content="Другое" Tag="Другое"/>
                </ComboBox>
                <Button Content="➕ Добавить" Width="130" Height="34" Margin="0,0,0,8" FontWeight="SemiBold" Background="#3A6DF0" Foreground="White" BorderThickness="0" Click="AddEvent_Click"/>
            </WrapPanel>

            <Border Grid.Row="2" CornerRadius="8" BorderBrush="#343848" BorderThickness="1" Background="#1F2129" Padding="4" Margin="0,0,0,12">
                <ListView x:Name="EventsList" Background="#1F2129" Foreground="White" BorderThickness="0" SelectionMode="Single">
                    <ListView.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3A6DF0"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Title}" Width="260"/>
                            <GridViewColumn Header="Начало" DisplayMemberBinding="{Binding StartDate}" Width="150"/>
                            <GridViewColumn Header="Окончание" DisplayMemberBinding="{Binding EndDate}" Width="150"/>
                            <GridViewColumn Header="Тип" DisplayMemberBinding="{Binding Type}" Width="160"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="🗑 Удалить выбранное" Width="180" Margin="0,0,10,0" Height="36" Background="#C44747" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Click="RemoveEvent_Click"/>
                <Button Content="💾 Сохранить" Width="140" Height="36" Background="#2D9A56" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Click="SaveEvents_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
