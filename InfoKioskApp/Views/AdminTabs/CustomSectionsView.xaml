<UserControl x:Class="InfoKioskApp.Views.AdminTabs.CustomSectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#20222A">

    <Border Background="#262933" CornerRadius="12" Padding="20" Margin="16" BorderBrush="#343848" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Пользовательские разделы" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

            <Border Grid.Row="1" Background="#1F2129" BorderBrush="#343848" BorderThickness="1" CornerRadius="8" Padding="8">
                <ListBox x:Name="SectionsList"
                         DisplayMemberPath="Name"
                         Background="#1F2129"
                         Foreground="White"
                         BorderThickness="0"/>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
                <Button Content="➕ Добавить" Width="140" Height="34" Margin="0,0,10,0" Click="Add_Click" Background="#2D9A56" Foreground="White" BorderThickness="0"/>
                <Button Content="❌ Удалить" Width="140" Height="34" Margin="0,0,10,0" Click="Remove_Click" Background="#C44747" Foreground="White" BorderThickness="0"/>
                <Button Content="💾 Сохранить" Width="140" Height="34" Click="Save_Click" Background="#3A6DF0" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
