<UserControl x:Class="InfoKioskApp.Views.AdminTabs.InterfaceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             Background="#2D2D30">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Orientation="Vertical">
            <TextBlock Text="Настройки интерфейса" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0 0 0 20"/>

            <TextBlock Text="Тема" FontWeight="Bold" Margin="0,10,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0 5">
                <TextBlock Text="Режим:" Width="220" VerticalAlignment="Center"/>
                <ComboBox x:Name="ThemeSelector" Foreground="Black" Width="220" SelectionChanged="ThemeSelector_SelectionChanged">
                    <ComboBoxItem Content="Тёмная" Tag="dark"/>
                    <ComboBoxItem Content="Светлая" Tag="light"/>
                </ComboBox>
            </StackPanel>

            <TextBlock Text="Цвета" FontWeight="Bold" Margin="0,14,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0 5">
                <TextBlock Text="Цвет фона:" Width="220" VerticalAlignment="Center"/>
                <xctk:ColorPicker x:Name="BackgroundColorPicker" Foreground="Black" Width="220" SelectedColorChanged="ColorPicker_SelectedColorChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0 5">
                <TextBlock Text="Цвет кнопок:" Width="220" VerticalAlignment="Center"/>
                <xctk:ColorPicker x:Name="ButtonColorPicker" Foreground="Black" Width="220" SelectedColorChanged="ColorPicker_SelectedColorChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0 5">
                <TextBlock Text="Цвет текста:" Width="220" VerticalAlignment="Center"/>
                <xctk:ColorPicker x:Name="TextColorPicker" Foreground="Black" Width="220" SelectedColorChanged="ColorPicker_SelectedColorChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0 5">
                <TextBlock Text="Цвет нав. кнопок:" Width="220" VerticalAlignment="Center"/>
                <xctk:ColorPicker x:Name="NavButtonColorPicker" Foreground="Black" Width="220"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0 5">
                <TextBlock Text="Цвет текста нав. кнопок:" Width="220" VerticalAlignment="Center"/>
                <xctk:ColorPicker x:Name="NavButtonTextColorPicker" Foreground="Black" Width="220"/>
            </StackPanel>

            <TextBlock Text="Шрифты" FontWeight="Bold" Margin="0,14,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0 5">
                <TextBlock Text="Семейство шрифта:" Width="220" VerticalAlignment="Center"/>
                <TextBox x:Name="FontFamilyTextBox" Width="220" Text="Segoe UI"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0 5">
                <TextBlock Text="Размер основного шрифта:" Width="220" VerticalAlignment="Center"/>
                <TextBox x:Name="FontSizeTextBox" Width="220" Text="14"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0 5">
                <TextBlock Text="Размер нав. кнопок:" Width="220" VerticalAlignment="Center"/>
                <TextBox x:Name="NavButtonFontSizeTextBox" Width="220" Text="15"/>
            </StackPanel>

            <TextBlock Text="Столовая" FontWeight="Bold" Margin="0,14,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0 5">
                <TextBlock Text="FoodBlockId:" Width="220" VerticalAlignment="Center"/>
                <TextBox x:Name="FoodBlockIdTextBox" Width="220" Height="28" VerticalContentAlignment="Center" Foreground="Black"/>
            </StackPanel>

            <TextBlock Text="Бегущая строка" FontWeight="Bold" Margin="0,14,0,5"/>
            <CheckBox x:Name="TickerEnabledCheck" Content="Включить бегущую строку" Margin="0,4,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0 5">
                <TextBlock Text="Текст:" Width="220" VerticalAlignment="Center"/>
                <TextBox x:Name="TickerTextBox" Width="420"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0 5">
                <TextBlock Text="Скорость:" Width="220" VerticalAlignment="Center"/>
                <TextBox x:Name="TickerSpeedTextBox" Width="220" Text="1.5"/>
            </StackPanel>

            <TextBlock Text="Экран неактивности" FontWeight="Bold" Margin="0,14,0,5"/>
            <CheckBox x:Name="IdleEnabledCheck" Content="Включить экран ожидания" Margin="0,4,0,4"/>
            <CheckBox x:Name="IdleLogoOnlyCheck" Content="Показывать только логотип" Margin="0,4,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0 5">
                <TextBlock Text="Таймаут неактивности (сек):" Width="220" VerticalAlignment="Center"/>
                <TextBox x:Name="IdleTimeoutTextBox" Width="220" Text="90"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0 5">
                <TextBlock Text="Смена слайда (сек):" Width="220" VerticalAlignment="Center"/>
                <TextBox x:Name="IdleSlideDurationTextBox" Width="220" Text="8"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0 20 0 0">
                <Button Content="✅ Применить" Width="150" Height="40" Margin="0,0,10,0" Background="Green" Foreground="White" Click="Apply_Click"/>
                <Button Content="💾 Сохранить" Width="150" Height="40" Background="#2A82DA" Foreground="White" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
