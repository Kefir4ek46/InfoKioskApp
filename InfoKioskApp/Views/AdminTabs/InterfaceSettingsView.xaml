<UserControl x:Class="InfoKioskApp.Views.AdminTabs.InterfaceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             Background="#20222A">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="#262933" CornerRadius="12" Padding="20" Margin="16" BorderBrush="#343848" BorderThickness="1">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Настройки интерфейса" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

                <TextBlock Text="Тема" FontWeight="Bold" Foreground="#DDE3F1" Margin="0,10,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Режим:" Width="220" VerticalAlignment="Center" Foreground="#DDE3F1"/>
                    <ComboBox x:Name="ThemeSelector" Width="240" SelectionChanged="ThemeSelector_SelectionChanged">
                        <ComboBoxItem Content="Тёмная" Tag="dark"/>
                        <ComboBoxItem Content="Светлая" Tag="light"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock Text="Цвета" FontWeight="Bold" Foreground="#DDE3F1" Margin="0,14,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Цвет фона:" Width="220" VerticalAlignment="Center" Foreground="#DDE3F1"/>
                    <xctk:ColorPicker x:Name="BackgroundColorPicker" Width="240" SelectedColorChanged="ColorPicker_SelectedColorChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Цвет кнопок:" Width="220" VerticalAlignment="Center" Foreground="#DDE3F1"/>
                    <xctk:ColorPicker x:Name="ButtonColorPicker" Width="240" SelectedColorChanged="ColorPicker_SelectedColorChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Цвет текста:" Width="220" VerticalAlignment="Center" Foreground="#DDE3F1"/>
                    <xctk:ColorPicker x:Name="TextColorPicker" Width="240" SelectedColorChanged="ColorPicker_SelectedColorChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Цвет нав. кнопок:" Width="220" VerticalAlignment="Center" Foreground="#DDE3F1"/>
                    <xctk:ColorPicker x:Name="NavButtonColorPicker" Width="240"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Цвет текста нав. кнопок:" Width="220" VerticalAlignment="Center" Foreground="#DDE3F1"/>
                    <xctk:ColorPicker x:Name="NavButtonTextColorPicker" Width="240"/>
                </StackPanel>

                <TextBlock Text="Шрифты" FontWeight="Bold" Foreground="#DDE3F1" Margin="0,14,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Семейство шрифта:" Width="220" VerticalAlignment="Center" Foreground="#DDE3F1"/>
                    <TextBox x:Name="FontFamilyTextBox" Width="240" Text="Segoe UI" Background="#1F2129" Foreground="White" BorderBrush="#343848" BorderThickness="1"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Размер основного шрифта:" Width="220" VerticalAlignment="Center" Foreground="#DDE3F1"/>
                    <TextBox x:Name="FontSizeTextBox" Width="240" Text="14" Background="#1F2129" Foreground="White" BorderBrush="#343848" BorderThickness="1"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Размер нав. кнопок:" Width="220" VerticalAlignment="Center" Foreground="#DDE3F1"/>
                    <TextBox x:Name="NavButtonFontSizeTextBox" Width="240" Text="15" Background="#1F2129" Foreground="White" BorderBrush="#343848" BorderThickness="1"/>
                </StackPanel>

                <TextBlock Text="Столовая" FontWeight="Bold" Foreground="#DDE3F1" Margin="0,14,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="FoodBlockId:" Width="220" VerticalAlignment="Center" Foreground="#DDE3F1"/>
                    <TextBox x:Name="FoodBlockIdTextBox" Width="240" Height="30" VerticalContentAlignment="Center" Background="#1F2129" Foreground="White" BorderBrush="#343848" BorderThickness="1"/>
                </StackPanel>

                <TextBlock Text="Бегущая строка" FontWeight="Bold" Foreground="#DDE3F1" Margin="0,14,0,5"/>
                <CheckBox x:Name="TickerEnabledCheck" Content="Включить бегущую строку" Margin="0,4,0,4" Foreground="White"/>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Текст:" Width="220" VerticalAlignment="Center" Foreground="#DDE3F1"/>
                    <TextBox x:Name="TickerTextBox" Width="420" Background="#1F2129" Foreground="White" BorderBrush="#343848" BorderThickness="1"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Скорость:" Width="220" VerticalAlignment="Center" Foreground="#DDE3F1"/>
                    <TextBox x:Name="TickerSpeedTextBox" Width="240" Text="1.5" Background="#1F2129" Foreground="White" BorderBrush="#343848" BorderThickness="1"/>
                </StackPanel>

                <TextBlock Text="Экран неактивности" FontWeight="Bold" Foreground="#DDE3F1" Margin="0,14,0,5"/>
                <CheckBox x:Name="IdleEnabledCheck" Content="Включить экран ожидания" Margin="0,4,0,4" Foreground="White"/>
                <CheckBox x:Name="IdleLogoOnlyCheck" Content="Показывать только логотип" Margin="0,4,0,4" Foreground="White"/>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Таймаут неактивности (сек):" Width="220" VerticalAlignment="Center" Foreground="#DDE3F1"/>
                    <TextBox x:Name="IdleTimeoutTextBox" Width="240" Text="90" Background="#1F2129" Foreground="White" BorderBrush="#343848" BorderThickness="1"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Смена слайда (сек):" Width="220" VerticalAlignment="Center" Foreground="#DDE3F1"/>
                    <TextBox x:Name="IdleSlideDurationTextBox" Width="240" Text="8" Background="#1F2129" Foreground="White" BorderBrush="#343848" BorderThickness="1"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Content="✅ Применить" Width="150" Height="38" Margin="0,0,10,0" Background="#2D9A56" Foreground="White" BorderThickness="0" Click="Apply_Click"/>
                    <Button Content="💾 Сохранить" Width="150" Height="38" Background="#3A6DF0" Foreground="White" BorderThickness="0" Click="Save_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
