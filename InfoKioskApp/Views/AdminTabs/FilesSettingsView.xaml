<UserControl x:Class="InfoKioskApp.Views.AdminTabs.FilesSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#20222A">

    <Border Background="#262933"
            CornerRadius="12"
            Padding="20"
            Margin="16"
            BorderBrush="#343848"
            BorderThickness="1">

        <StackPanel>
            <TextBlock Text="Настройки путей к файлам" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,18"/>

            <TextBlock Text="Основное расписание" Foreground="#DDE3F1" Margin="0,0,0,6"/>
            <DockPanel Margin="0,0,0,14">
                <TextBox x:Name="MainSchedulePathBox"
                         Height="34"
                         Padding="8,6"
                         Background="#1F2129"
                         Foreground="White"
                         BorderBrush="#343848"
                         BorderThickness="1"
                         VerticalContentAlignment="Center"
                         DockPanel.Dock="Left"/>
                <Button Content="📂 Обзор"
                        Width="120"
                        Height="34"
                        Margin="10,0,0,0"
                        Background="#3A6DF0"
                        Foreground="White"
                        BorderThickness="0"
                        Click="BrowseMainSchedule_Click"/>
            </DockPanel>

            <TextBlock Text="Изменённое расписание" Foreground="#DDE3F1" Margin="0,0,0,6"/>
            <DockPanel Margin="0,0,0,18">
                <TextBox x:Name="ChangesPathBox"
                         Height="34"
                         Padding="8,6"
                         Background="#1F2129"
                         Foreground="White"
                         BorderBrush="#343848"
                         BorderThickness="1"
                         VerticalContentAlignment="Center"
                         DockPanel.Dock="Left"/>
                <Button Content="📂 Обзор"
                        Width="120"
                        Height="34"
                        Margin="10,0,0,0"
                        Background="#3A6DF0"
                        Foreground="White"
                        BorderThickness="0"
                        Click="BrowseChanges_Click"/>
            </DockPanel>

            <Button Content="💾 Сохранить пути"
                    Width="220"
                    Height="36"
                    HorizontalAlignment="Left"
                    Background="#2D9A56"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Click="SavePaths_Click"/>
        </StackPanel>
    </Border>
</UserControl>
