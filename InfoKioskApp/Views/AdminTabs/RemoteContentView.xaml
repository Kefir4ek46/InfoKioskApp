<UserControl x:Class="InfoKioskApp.Views.AdminTabs.RemoteContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="📁 Управление контентом"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,15"/>

        <!-- Основной контент -->
        <TabControl Grid.Row="1" x:Name="Tabs" Background="#252525" Foreground="White">
            <TabItem Header="Документы" Background="Gray">
                <ListBox x:Name="DocsList" Background="#2C2C2C" Foreground="White"/>
            </TabItem>
            <TabItem Header="Медиа" Background="Gray">
                <ListBox x:Name="MediaList" Background="#2C2C2C" Foreground="White"/>
            </TabItem>
            <TabItem Header="Расписания" Background="Gray">
                <ListBox x:Name="ScheduleList" Background="#2C2C2C" Foreground="White"/>
            </TabItem>
            <TabItem Header="Календарь" Background="Gray">
                <StackPanel Margin="10">
                    <TextBlock Text="Добавить событие:"  Foreground="White" Margin="0,0,0,5"/>
                    <TextBox x:Name="EventTitle" Background="#333" Foreground="White" Padding="4" Margin="0,0,0,5"/>
                    <ComboBox x:Name="EventType" SelectedIndex="0" Background="#333" Foreground="White" Margin="0,0,0,5">
                        <ComboBoxItem Content="Праздник"/>
                        <ComboBoxItem Content="Каникулы"/>
                        <ComboBoxItem Content="Выходной"/>
                        <ComboBoxItem Content="Другое"/>
                    </ComboBox>
                    <DatePicker x:Name="StartDate" Margin="0,5,0,0"/>
                    <DatePicker x:Name="EndDate" Margin="0,5,0,10"/>
                    <Button Content="Добавить событие"
                            Click="AddEvent_Click"
                            Background="#3A9FFF"
                            Foreground="White"
                            Padding="6,3"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <Button Content="🔄 Обновить" Click="Refresh_Click" Background="#3A3A3A" Foreground="White" Margin="5" Padding="6,3"/>
            <Button Content="⬆ Загрузить" Click="Upload_Click" Background="#3A9FFF" Foreground="White" Margin="5" Padding="6,3"/>
            <Button Content="🗑 Удалить" Click="Delete_Click" Background="#C0392B" Foreground="White" Margin="5" Padding="6,3"/>
        </StackPanel>
    </Grid>
</UserControl>
