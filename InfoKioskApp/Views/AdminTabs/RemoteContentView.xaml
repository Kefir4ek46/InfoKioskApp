<UserControl x:Class="InfoKioskApp.Views.AdminTabs.RemoteContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#20222A">

    <Border Background="#262933" CornerRadius="12" Padding="20" Margin="16" BorderBrush="#343848" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="📁 Управление контентом" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,14"/>

            <TabControl Grid.Row="1" x:Name="Tabs" Background="#1F2129" Foreground="White" BorderBrush="#343848" BorderThickness="1">
                <TabItem Header="Документы">
                    <ListBox x:Name="DocsList" Background="#1F2129" Foreground="White" BorderThickness="0"/>
                </TabItem>
                <TabItem Header="Медиа">
                    <ListBox x:Name="MediaList" Background="#1F2129" Foreground="White" BorderThickness="0"/>
                </TabItem>
                <TabItem Header="Расписания">
                    <ListBox x:Name="ScheduleList" Background="#1F2129" Foreground="White" BorderThickness="0"/>
                </TabItem>
                <TabItem Header="Календарь">
                    <StackPanel Margin="12">
                        <TextBlock Text="Добавить событие:" Foreground="#DDE3F1" Margin="0,0,0,6"/>
                        <TextBox x:Name="EventTitle" Background="#1F2129" Foreground="White" BorderBrush="#343848" BorderThickness="1" Padding="8,6" Margin="0,0,0,6"/>
                        <ComboBox x:Name="EventType" SelectedIndex="0" Background="#1F2129" Foreground="White" BorderBrush="#343848" BorderThickness="1" Margin="0,0,0,6">
                            <ComboBoxItem Content="Праздник"/>
                            <ComboBoxItem Content="Каникулы"/>
                            <ComboBoxItem Content="Выходной"/>
                            <ComboBoxItem Content="Другое"/>
                        </ComboBox>
                        <DatePicker x:Name="StartDate" Margin="0,0,0,6"/>
                        <DatePicker x:Name="EndDate" Margin="0,0,0,10"/>
                        <Button Content="Добавить событие" Click="AddEvent_Click" Width="180" Height="34" Background="#3A6DF0" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                <Button Content="🔄 Обновить" Click="Refresh_Click" Width="130" Height="34" Margin="0,0,10,0" Background="#4A4F5F" Foreground="White" BorderThickness="0"/>
                <Button Content="⬆ Загрузить" Click="Upload_Click" Width="130" Height="34" Margin="0,0,10,0" Background="#3A6DF0" Foreground="White" BorderThickness="0"/>
                <Button Content="🗑 Удалить" Click="Delete_Click" Width="130" Height="34" Background="#C44747" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
