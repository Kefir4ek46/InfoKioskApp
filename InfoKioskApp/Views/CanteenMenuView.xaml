<UserControl x:Class="InfoKioskApp.Views.CanteenMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">

    <UserControl.Resources>

        <!-- Цвета -->
        <SolidColorBrush x:Key="PanelBrush" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2D8CFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#EAEAEA"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#B0B0B0"/>

        <!-- Кнопки дней -->
        <Style x:Key="DayButtonStyle" TargetType="Button">

            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Нажатие -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border"
                                Property="Background"
                                Value="#2D8CFF"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>


        <!-- Темный DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="RowBackground" Value="#2A2A2A"/>
            <Setter Property="AlternatingRowBackground" Value="#323232"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="All"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Заголовки колонок -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Кнопки дней -->
        <UniformGrid x:Name="DaysPanel"
             Columns="5"
             HorizontalAlignment="Stretch"
             Margin="0,10">

            <Button Content="Понедельник"
            Tag="Monday"
            Click="DayButton_Click"
            Style="{StaticResource DayButtonStyle}"/>

            <Button Content="Вторник"
            Tag="Tuesday"
            Click="DayButton_Click"
            Style="{StaticResource DayButtonStyle}"/>

            <Button Content="Среда"
            Tag="Wednesday"
            Click="DayButton_Click"
            Style="{StaticResource DayButtonStyle}"/>

            <Button Content="Четверг"
            Tag="Thursday"
            Click="DayButton_Click"
            Style="{StaticResource DayButtonStyle}"/>

            <Button Content="Пятница"
            Tag="Friday"
            Click="DayButton_Click"
            Style="{StaticResource DayButtonStyle}"/>

        </UniformGrid>


        <!-- Статус -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Foreground="Orange"
                   FontSize="18"
                   VerticalAlignment="Center"/>

        <!-- Таблица -->
        <Border Grid.Row="2"
                Background="#2A2A2A"
                CornerRadius="12"
                BorderBrush="#3A3A3A"
                BorderThickness="1"
                Padding="10">

            <DataGrid x:Name="MenuGrid"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"/>
        </Border>

    </Grid>
</UserControl>
