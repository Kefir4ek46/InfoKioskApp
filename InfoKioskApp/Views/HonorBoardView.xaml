<UserControl x:Class="InfoKioskApp.Views.HonorBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🏅 Мы ими гордимся" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>

        <UniformGrid x:Name="CardsGrid" Grid.Row="1" Rows="2" Columns="3" Margin="0,8,0,8" MinHeight="760"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button Content="⟵ Назад" Width="130" Margin="0,0,10,0" Click="PrevPage_Click"/>
            <TextBlock x:Name="PageInfoText" Foreground="White" VerticalAlignment="Center" FontSize="18"/>
            <Button Content="Вперед ⟶" Width="130" Margin="10,0,0,0" Click="NextPage_Click"/>
        </StackPanel>

        <Grid x:Name="DetailsOverlay" Grid.RowSpan="3" Background="#C8000000" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border Margin="20" Background="#1A1C22" CornerRadius="12" BorderBrush="#2F3340" BorderThickness="1" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Content="✕" Width="38" Height="38" HorizontalAlignment="Right" VerticalAlignment="Top" Click="CloseOverlay_Click"/>

                    <Border Grid.Column="0" Margin="0,32,12,0" BorderBrush="#2F3340" BorderThickness="1" CornerRadius="8">
                        <Image x:Name="DetailPhoto" Stretch="Uniform"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="0,38,0,0">
                        <TextBlock x:Name="DetailName" FontSize="34" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                        <Border Background="#11131A" BorderBrush="#2F3340" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                                <TextBlock x:Name="DetailDescription" Foreground="White" FontSize="22" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
