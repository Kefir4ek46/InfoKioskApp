<UserControl x:Class="InfoKioskApp.Views.HonorBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="🏅 Мы ими гордимся" FontSize="30" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
            <TextBlock Text="Доска почёта: нажмите на карточку, чтобы увидеть подробности." FontSize="15" Foreground="#AAB4C8"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <UniformGrid x:Name="CardsGrid" Rows="2" Columns="3" MinHeight="760"/>
            <TextBlock x:Name="EmptyStateText"
                       Visibility="Collapsed"
                       Text="Пока нет карточек на доске почета"
                       Foreground="#8F9AB1"
                       FontSize="24"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="⟵ Назад" Width="130" Margin="0,0,10,0" Click="PrevPage_Click"/>
            <TextBlock x:Name="PageInfoText" Foreground="White" VerticalAlignment="Center" FontSize="18"/>
            <Button Content="Вперед ⟶" Width="130" Margin="10,0,0,0" Click="NextPage_Click"/>
        </StackPanel>

        <Grid x:Name="DetailsOverlay" Grid.RowSpan="3" Background="#CB000000" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border Margin="14" Background="#1A1F2C" CornerRadius="14" BorderBrush="#33405A" BorderThickness="1" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.49*"/>
                        <ColumnDefinition Width="0.51*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Content="✕" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top" Click="CloseOverlay_Click"/>

                    <Border Grid.Column="0" Margin="0,34,18,0" BorderBrush="#33405A" BorderThickness="1" CornerRadius="10" Background="#111522">
                        <Image x:Name="DetailPhoto" Stretch="Uniform"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="0,44,0,0">
                        <TextBlock x:Name="DetailName" FontSize="50" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                        <Border Background="#0D1322" BorderBrush="#2B3852" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,18,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                                <TextBlock x:Name="DetailDescription" Foreground="#F3F6FF" FontSize="26" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
