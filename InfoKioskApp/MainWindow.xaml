<Window x:Class="InfoKioskApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:views="clr-namespace:InfoKioskApp.Views"
        Title="InfoKioskApp"
        WindowStyle="None"
        WindowState="Maximized"
        Background="#1E1E1E"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Grid>
        <!-- Основной WebView2 с киоск-интерфейсом (HTML из /web/) -->
        <wv2:WebView2 x:Name="KioskWebView"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"/>

        <!-- Оверлей: отдельный WebView2 с сайтом школы.
             Visibility управляется из C# (SchoolWebsiteViewManager).
             Поверх основного киоска, перекрывает его полностью. -->
        <views:SchoolWebsiteView x:Name="SchoolSiteView"
                                 Visibility="Collapsed"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"/>
    </Grid>
</Window>
